<Window x:Class="FocusLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FocusLedger.App.ViewModels"
        xmlns:views="clr-namespace:FocusLedger.App.Views"
        xmlns:loc="clr-namespace:FocusLedger.App.Localization"
        Title="FocusLedger"
        Icon="/Assets/app.ico"
        Height="740" Width="1120"
        MinHeight="620" MinWidth="920"
        Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TodayViewModel}">
            <views:TodayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <views:RulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
            <views:CalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏：悬浮的大圆角面板 -->
        <Border Grid.Column="0"
                Margin="14,14,0,14"
                CornerRadius="24"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="1">
            <Grid Margin="16,22,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="6,0,6,22">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="10"
                                Background="{DynamicResource Text}">
                            <TextBlock Text="F" FontSize="16" FontWeight="Bold"
                                       Foreground="{DynamicResource Bg}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="FocusLedger" FontSize="16" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{loc:T App_Tagline}" Style="{StaticResource Caption}"
                               FontSize="11.5" TextWrapping="Wrap" Margin="0,12,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" CornerRadius="16"
                        Background="{DynamicResource SurfaceAlt}"
                        Padding="14,11" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:T App_LocalOnly}" Style="{StaticResource Caption}"
                                   FontSize="10.5" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 内容 -->
        <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="28,26,28,26" />
    </Grid>
</Window>
