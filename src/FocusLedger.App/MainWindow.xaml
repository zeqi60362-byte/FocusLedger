<Window x:Class="FocusLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FocusLedger.App.ViewModels"
        xmlns:views="clr-namespace:FocusLedger.App.Views"
        xmlns:loc="clr-namespace:FocusLedger.App.Localization"
        Title="FocusLedger"
        Height="740" Width="1120"
        MinHeight="620" MinWidth="920"
        Background="{DynamicResource Bg}"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TodayViewModel}">
            <views:TodayView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ReportViewModel}">
            <views:ReportView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RulesViewModel}">
            <views:RulesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CalendarViewModel}">
            <views:CalendarView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="212" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.Column="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,1,0">
            <Grid Margin="14,20,14,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="8,0,0,20">
                    <TextBlock Text="FocusLedger" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock Text="{loc:T App_Tagline}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Entries}"
                         SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource NavItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Margin="0,3,0,3" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Row="2" Margin="8,12,0,0">
                    <TextBlock Text="{Binding StatusText}" FontSize="12" />
                    <TextBlock Text="{loc:T App_LocalOnly}" Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 内容 -->
        <ContentControl Grid.Column="1" Content="{Binding Current}" Margin="26,22,26,22" />
    </Grid>
</Window>
