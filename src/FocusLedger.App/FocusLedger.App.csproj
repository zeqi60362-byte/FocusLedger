<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>FocusLedger</AssemblyName>
    <RootNamespace>FocusLedger.App</RootNamespace>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- 同时启用 WPF 与 WinForms 会引入 System.Drawing / System.Windows.Forms 隐式 using，
         与 WPF 的 Brush/Color/Point/UserControl 冲突。这里移除，需要的文件自行显式引用。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FocusLedger.Core\FocusLedger.Core.csproj" />
    <ProjectReference Include="..\FocusLedger.Storage\FocusLedger.Storage.csproj" />
    <ProjectReference Include="..\FocusLedger.Collector.Windows\FocusLedger.Collector.Windows.csproj" />
  </ItemGroup>

</Project>
