<UserControl x:Class="FocusLedger.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Hidden">
        <StackPanel>
            <TextBlock Text="{loc:T Settings_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{loc:T Settings_Desc}" Style="{StaticResource Caption}" Margin="0,4,0,16" />

            <!-- 皮肤 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Theme}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{loc:T Settings_ThemeDesc}" Style="{StaticResource Caption}" Margin="0,4,0,10" />

                    <!-- 卡片底部留白统一交给 Card 的 padding，这里不再自己加 12 -->
                    <StackPanel Orientation="Horizontal">
                        <!-- 当前生效的那一档要看得出来：选中态用深底白字 -->
                        <Button Content="{loc:T Theme_Dark}" Padding="14,5" Margin="0,0,8,0"
                                Command="{Binding SetThemeCommand}" CommandParameter="Dark">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTheme}" Value="Dark">
                                            <Setter Property="Background" Value="#2B2B2B" />
                                            <Setter Property="BorderBrush" Value="#2B2B2B" />
                                            <Setter Property="Foreground" Value="#F2F2F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:T Theme_Light}" Padding="14,5" Margin="0,0,8,0"
                                Command="{Binding SetThemeCommand}" CommandParameter="Light">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTheme}" Value="Light">
                                            <Setter Property="Background" Value="#2B2B2B" />
                                            <Setter Property="BorderBrush" Value="#2B2B2B" />
                                            <Setter Property="Foreground" Value="#F2F2F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:T Theme_Midnight}" Padding="14,5"
                                Command="{Binding SetThemeCommand}" CommandParameter="Midnight">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTheme}" Value="Midnight">
                                            <Setter Property="Background" Value="#2B2B2B" />
                                            <Setter Property="BorderBrush" Value="#2B2B2B" />
                                            <Setter Property="Foreground" Value="#F2F2F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                </StackPanel>
            </Border>

            <!-- 节假日 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Holidays}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{loc:T Settings_HolidaysDesc}" Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Region" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Width="72" Padding="8,4" Text="{Binding HolidayRegion, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{loc:T Holiday_Import}" Style="{StaticResource GhostButton}" Padding="14,5" Margin="10,0,0,0"
                                Command="{Binding ImportHolidaysCommand}" />
                    </StackPanel>
                    <!-- 平时是空串：不折叠的话会一直占着 8px 边距 + 一行高度，把卡片撑高 -->
                    <TextBlock Text="{Binding HolidayStatus}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Margin" Value="0,8,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HolidayStatus}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
            <!-- 语言 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Language}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{loc:T Settings_LanguageDesc}" Style="{StaticResource Caption}" Margin="0,4,0,10" />
                    <CheckBox Content="English" IsChecked="{Binding IsEnglish}" />
                </StackPanel>
            </Border>

            <!-- 启动 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Startup}" Style="{StaticResource H2}" FontSize="13.5" />
                    <CheckBox Content="{loc:T Settings_AutoStart}" Margin="0,12,0,0"
                              IsChecked="{Binding StartWithWindows}" />
                </StackPanel>
            </Border>

            <!-- 数据保留 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Retention}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{loc:T Settings_RetentionDesc}" Style="{StaticResource Caption}"
                               Margin="0,4,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="80" Padding="10,4" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{loc:T Settings_Days}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 排除列表 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Exclude}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{loc:T Settings_ExcludeDesc}" Style="{StaticResource Caption}"
                               Margin="0,4,0,10" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Width="240" Padding="10,4" Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="{loc:T Settings_Add}" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding AddExclusionCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="{loc:T Settings_Remove}" Style="{StaticResource GhostButton}" Padding="8,3"
                                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 数据操作 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="{loc:T Settings_Data}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{Binding StorageInfo}" Style="{StaticResource Caption}" Margin="0,8,0,12"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="{loc:T Settings_Import}" Style="{StaticResource GhostButton}"
                                Command="{Binding ImportTimerCsvCommand}" />
                        <Button Content="{loc:T Settings_Export}" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Command="{Binding ExportCsvCommand}" />
                        <Button Content="{loc:T Settings_DeleteAll}" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Foreground="{DynamicResource Danger}" Command="{Binding DeleteAllCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                                <Setter Property="Margin" Value="0,12,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
