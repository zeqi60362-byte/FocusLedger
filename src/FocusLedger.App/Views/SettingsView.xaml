<UserControl x:Class="FocusLedger.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="设置" Style="{StaticResource H2}" />
            <TextBlock Text="所有设置在本地生效，不会上传任何内容。" Style="{StaticResource Caption}" Margin="0,4,0,16" />

            <!-- 启动 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="启动" Style="{StaticResource H2}" FontSize="13.5" />
                    <CheckBox Content="开机时自动启动 FocusLedger" Margin="0,12,0,0"
                              IsChecked="{Binding StartWithWindows}" />
                </StackPanel>
            </Border>

            <!-- 数据保留 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="数据保留" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="原始样本（每 5 秒一条）超过保留天数后会被清理，日聚合与标注不受影响。"
                               Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox Width="80" Text="{Binding RetentionDays, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="天" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 排除列表 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="排除列表" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="命中的进程不会被记录，例如密码管理器、私人聊天工具。"
                               Style="{StaticResource Caption}" Margin="0,4,0,10" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBox Width="240" Text="{Binding NewExclusion, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="添加" Style="{StaticResource GhostButton}" Margin="8,0,0,0"
                                Command="{Binding AddExclusionCommand}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Exclusions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="240" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12.5" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="移除" Style="{StaticResource GhostButton}" Padding="8,3"
                                            Command="{Binding DataContext.RemoveExclusionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 数据操作 -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="数据" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{Binding StorageInfo}" Style="{StaticResource Caption}" Margin="0,8,0,12"
                               TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="导出今日 CSV" Style="{StaticResource GhostButton}"
                                Command="{Binding ExportCsvCommand}" />
                        <Button Content="删除全部数据" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                                Foreground="{StaticResource Danger}" Command="{Binding DeleteAllCommand}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,12,0,0"
                               TextWrapping="Wrap" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
