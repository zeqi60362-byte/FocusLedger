<UserControl x:Class="FocusLedger.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls"
             xmlns:views="clr-namespace:FocusLedger.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="今天" Style="{StaticResource H2}" />
                <TextBlock x:Name="DateLabel" Style="{StaticResource Caption}" Margin="10,2,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding RecordButtonText}"
                    Command="{Binding ToggleRecordingCommand}" />
        </Grid>

        <!-- 意图声明 -->
        <views:IntentPanel Grid.Row="1" Margin="0,16,0,0" DataContext="{Binding Intent}" />

        <!-- 主数字 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="有效专注" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,8,7" />
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Band}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                </StackPanel>

                <TextBlock Text="{Binding Breakdown}" Margin="0,10,0,0" FontSize="12.5" />
                <TextBlock Text="{Binding Secondary}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding Coverage}" Style="{StaticResource Caption}" Margin="0,6,0,0" Opacity="0.8" />
                <TextBlock Text="{Binding Current}" Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{StaticResource Accent}" />
            </StackPanel>
        </Border>

        <!-- 时间轴 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="时间轴" Style="{StaticResource H2}" FontSize="13.5" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource StateActive}" Margin="16,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="深度" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource StatePassive}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="被动" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource StateSilent}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="静默" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource StateOffTask}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="分心" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource StateIdle}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="离席" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{StaticResource StateLocked}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="锁屏" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="1 小时" Style="{StaticResource GhostButton}" Padding="9,4" Margin="0,0,6,0"
                                Command="{Binding SetZoomCommand}" CommandParameter="hour" />
                        <Button Content="6 小时" Style="{StaticResource GhostButton}" Padding="9,4" Margin="0,0,6,0"
                                Command="{Binding SetZoomCommand}" CommandParameter="six" />
                        <Button Content="全天" Style="{StaticResource GhostButton}" Padding="9,4"
                                Command="{Binding SetZoomCommand}" CommandParameter="day" />
                    </StackPanel>
                </Grid>

                <controls:TimelineControl Grid.Row="1"
                                          x:Name="Timeline"
                                          MinHeight="130"
                                          Segments="{Binding Segments}"
                                          WindowStart="{Binding WindowStart}"
                                          WindowEnd="{Binding WindowEnd}"
                                          SegmentSelected="OnSegmentSelected" />

                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="4,10,4,0"
                           Text="把鼠标放到色带上可看细节，点一下看它为什么被这样判定。" />
            </Grid>
        </Border>

        <!-- 下钻 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0">
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12.5" LineHeight="21" />
        </Border>
    </Grid>
</UserControl>
