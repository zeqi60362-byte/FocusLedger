<UserControl x:Class="FocusLedger.App.Views.TodayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls"
             xmlns:views="clr-namespace:FocusLedger.App.Views"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Today_Title}" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding DateLabel}" Style="{StaticResource Caption}" Margin="10,2,0,0" VerticalAlignment="Bottom" />
            </StackPanel>
            <Button HorizontalAlignment="Right"
                    Style="{StaticResource PrimaryButton}"
                    Content="{Binding RecordButtonText}"
                    Command="{Binding ToggleRecordingCommand}" />
        </Grid>

        <!-- 意图声明 -->
        <views:IntentPanel Grid.Row="1" Margin="0,16,0,0" DataContext="{Binding Intent}" />

        <!-- 主数字 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{loc:T Today_Effective}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,8,7" />
                    <TextBlock Text="{Binding Headline}" Style="{StaticResource H1}" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding Chips}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border CornerRadius="14" Padding="11,5" Margin="0,0,8,0" Background="{DynamicResource SurfaceAlt}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock FontSize="12.5">
                                        <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource TextDim}" />
                                        <Run Text="  " />
                                        <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Coverage}" Style="{StaticResource Caption}" Margin="0,8,0,0" Opacity="0.8" />
                <TextBlock Text="{Binding Current}" Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" />
            </StackPanel>
        </Border>

        <!-- 时间轴 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0,4,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Today_Timeline}" Style="{StaticResource H2}" FontSize="13.5" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" Fill="{DynamicResource StateActive}" Margin="16,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T State_Active}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" Fill="{DynamicResource StateSilent}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T State_Silent}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" Fill="{DynamicResource StateOffTask}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T State_OffTask}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" Fill="{DynamicResource StateIdle}" Margin="10,0,5,0" VerticalAlignment="Center" />
                        <TextBlock Text="{loc:T State_Away}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{loc:T Today_ZoomHour}" Padding="9,4" Margin="0,0,6,0"
                                Command="{Binding SetZoomCommand}" CommandParameter="hour">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHourZoom}" Value="True">
                                            <Setter Property="Background" Value="#2B2B2B" />
                                            <Setter Property="BorderBrush" Value="#2B2B2B" />
                                            <Setter Property="Foreground" Value="#F2F2F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:T Today_ZoomSix}" Padding="9,4" Margin="0,0,6,0"
                                Command="{Binding SetZoomCommand}" CommandParameter="six">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSixZoom}" Value="True">
                                            <Setter Property="Background" Value="#2B2B2B" />
                                            <Setter Property="BorderBrush" Value="#2B2B2B" />
                                            <Setter Property="Foreground" Value="#F2F2F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="{loc:T Today_ZoomDay}" Padding="9,4"
                                Command="{Binding SetZoomCommand}" CommandParameter="day">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDayZoom}" Value="True">
                                            <Setter Property="Background" Value="#2B2B2B" />
                                            <Setter Property="BorderBrush" Value="#2B2B2B" />
                                            <Setter Property="Foreground" Value="#F2F2F0" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>

                <controls:TimelineControl Grid.Row="1"
                                          x:Name="Timeline"
                                          Height="150"
                                          Segments="{Binding Segments}"
                                          WindowStart="{Binding WindowStart}"
                                          WindowEnd="{Binding WindowEnd}"
                                          SegmentSelected="OnSegmentSelected" />

                <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Margin="4,10,4,0"
                           Text="{loc:T Today_TimelineHint}" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <!-- 下钻 -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,14,0,0">
            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="12.5" LineHeight="21" />
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
