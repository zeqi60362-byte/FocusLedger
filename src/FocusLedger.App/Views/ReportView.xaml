<UserControl x:Class="FocusLedger.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 顶栏 -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Report_Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="10,2,0,0" VerticalAlignment="Bottom" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Report_Prev}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                            Command="{Binding PreviousDayCommand}" />
                    <Button Content="{loc:T Report_Today}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                            Command="{Binding TodayCommand}" />
                    <Button Content="{loc:T Report_Next}" Style="{StaticResource GhostButton}" Padding="10,5"
                            Command="{Binding NextDayCommand}" />
                </StackPanel>
            </Grid>

            <!-- 当天汇总 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Today_Effective}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,8,7" />
                        <TextBlock Text="{Binding Effective}" Style="{StaticResource H1}" />
                        <TextBlock Text="{Binding Band}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,0,24,0" FontSize="13">
                                    <Run Text="{Binding Label, Mode=OneWay}" FontWeight="Bold" />
                                    <Run Text="  " />
                                    <Run Text="{Binding Value, Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatsRow}" Style="{StaticResource Caption}" Margin="0,8,0,0" Opacity="0.8" />
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" />
                </StackPanel>
            </Border>

            <!-- 分心归因 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T Report_DistractionTitle}" Style="{StaticResource H2}" FontSize="13.5" />
                    <ItemsControl ItemsSource="{Binding Distractions}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="60" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding App}" FontSize="12.5" />
                                    <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Caption}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Share}" Style="{StaticResource Caption}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 统计 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:T Report_Stats}" Style="{StaticResource H2}" FontSize="13.5" />
                            <TextBlock Text="{Binding StatsSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="{loc:T Report_Week}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="week" />
                            <Button Content="{loc:T Report_Month}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="month" />
                            <Button Content="{loc:T Report_Year}" Style="{StaticResource GhostButton}" Padding="10,4"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="year" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Effective}" FontSize="12.5"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <controls:ProportionBar Height="8" Track="Transparent" Slices="{Binding Bar}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   FontSize="10.5" Margin="0,4,0,0" Opacity="0.75" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
