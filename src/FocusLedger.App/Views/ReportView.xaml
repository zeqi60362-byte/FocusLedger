<UserControl x:Class="FocusLedger.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="日报" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="10,2,0,0" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="前一天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding PreviousDayCommand}" />
                <Button Content="今天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding TodayCommand}" />
                <Button Content="后一天" Style="{StaticResource GhostButton}" Padding="10,5"
                        Command="{Binding NextDayCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="有效专注" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,8,7" />
                    <TextBlock Text="{Binding Effective}" Style="{StaticResource H1}" />
                    <TextBlock Text="{Binding Band}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="10,0,0,8" />
                </StackPanel>

                <TextBlock Text="{Binding PrimaryRow}" Margin="0,12,0,0" FontSize="12.5" />
                <TextBlock Text="{Binding SecondaryRow}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding StatsRow}" Style="{StaticResource Caption}" Margin="0,6,0,0" Opacity="0.8" />
                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{StaticResource Accent}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="分心归因" Style="{StaticResource H2}" FontSize="13.5" />
                <TextBlock Text="按应用汇总当天的分心时长，用于回答「差值去哪了」。"
                           Style="{StaticResource Caption}" Margin="0,4,0,12" />

                <ItemsControl ItemsSource="{Binding Distractions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="90" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding App}" FontSize="12.5" />
                                <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Caption}" />
                                <TextBlock Grid.Column="2" Text="{Binding Share}" Style="{StaticResource Caption}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Opacity="0.7"
                           Text="番茄钟对账（导入 CSV 生成声称 vs 实证差额）将在 M3 提供。" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
