<UserControl x:Class="FocusLedger.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <!-- 顶栏 -->
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Report_Title}" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="10,2,0,0" VerticalAlignment="Bottom" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{loc:T Report_Prev}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                            Command="{Binding PreviousDayCommand}" />
                    <Button Content="{loc:T Report_Today}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                            Command="{Binding TodayCommand}" />
                    <Button Content="{loc:T Report_Next}" Style="{StaticResource GhostButton}" Padding="10,5"
                            Command="{Binding NextDayCommand}" />
                </StackPanel>
            </Grid>

            <!-- 当天汇总 -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Today_Effective}" Style="{StaticResource Caption}" VerticalAlignment="Bottom" Margin="0,0,8,7" />
                        <TextBlock Text="{Binding Effective}" Style="{StaticResource H1}" />
                        <TextBlock Text="{loc:T Today_EffectiveFormula}" Style="{StaticResource Caption}"
                                   VerticalAlignment="Bottom" Margin="10,0,0,7" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Chips}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="14" Padding="11,5" Margin="0,0,8,0" Background="{DynamicResource SurfaceAlt}">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock FontSize="12.5">
                                            <Run Text="{Binding Label, Mode=OneWay}" Foreground="{DynamicResource Text}" FontWeight="SemiBold" />
                                            <Run Text="  " />
                                            <Run Text="{Binding Value, Mode=OneWay}" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding StatsRow}" Style="{StaticResource Caption}" Margin="0,8,0,0" Opacity="0.8" />
                    <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource Caption}" Margin="0,10,0,0" Foreground="{DynamicResource Accent}" />
                </StackPanel>
            </Border>

            <!-- 三张并列：状态构成 / 软件用时 / 分心点 -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{loc:T Report_BreakdownTitle}" Style="{StaticResource H2}" FontSize="13.5" />
                        <TextBlock Text="{loc:T Report_CompositionNote}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <controls:DonutChart Height="150" Margin="0,20,0,10"
                                             Slices="{Binding DonutSlices}"
                                             CenterValue="{Binding DonutValue}"
                                             CenterLabel="{Binding DonutLabel}" />
                        <ItemsControl ItemsSource="{Binding Legend}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Fill}" HorizontalAlignment="Left">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Rectangle Width="8" Height="1.5" RadiusX="1" RadiusY="1"
                                                       Fill="{DynamicResource TextDim}" Opacity="0.55"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" Style="{StaticResource Caption}" />
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}"
                                                   HorizontalAlignment="Right" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Report_AppTime}" Style="{StaticResource H2}" FontSize="13.5" />
                        <TextBlock Text="{loc:T Report_AppNote}" Style="{StaticResource Caption}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        <controls:DonutChart Height="150" Margin="0,20,0,10"
                                             Slices="{Binding AppSlices}"
                                             CenterValue="{Binding AppTotal}"
                                             CenterLabel="{loc:T Report_AppTotal}" />
                        <ItemsControl ItemsSource="{Binding AppLegend}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="54" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" VerticalAlignment="Center">
                                            <Ellipse Width="8" Height="8" Fill="{Binding Fill}" HorizontalAlignment="Left">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <Rectangle Width="8" Height="1.5" RadiusX="1" RadiusY="1"
                                                       Fill="{DynamicResource TextDim}" Opacity="0.55"
                                                       VerticalAlignment="Center" HorizontalAlignment="Left">
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                        </Grid>
                                        <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                            <Setter Property="Margin" Value="14,0,0,0" />
                                                            <Setter Property="FontSize" Value="11" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Grid.Column="2" Text="{Binding Value}" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsChild}" Value="True">
                                                            <Setter Property="FontSize" Value="11" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{loc:T Report_DistractionTitle}" Style="{StaticResource H2}" FontSize="13.5" />
                        <ItemsControl ItemsSource="{Binding Distractions}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="64" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding App}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Duration}" Style="{StaticResource Caption}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Share}" Style="{StaticResource Caption}"
                                                       HorizontalAlignment="Right" />
                                        </Grid>
                                        <controls:ProportionBar Height="4" Margin="0,6,0,0"
                                                                Track="{DynamicResource TrackBg}" Slices="{Binding Bar}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 应用流转（桑基图） -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{loc:T Report_FlowTitle}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{loc:T Report_FlowHint}" Style="{StaticResource Caption}"
                               Margin="0,4,0,10" TextWrapping="Wrap" />
                    <controls:SankeyChart Height="250" Flows="{Binding Flows}" />
                    <ItemsControl ItemsSource="{Binding FlowLegend}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,18,6">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Fill}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding Label}" Style="{StaticResource Caption}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- 统计 -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="{loc:T Report_Stats}" Style="{StaticResource H2}" FontSize="13.5" />
                            <TextBlock Text="{Binding StatsSummary}" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button Content="{loc:T Report_MetricEffective}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetMetricCommand}" CommandParameter="effective">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEffectiveMetric}" Value="True">
                                                <Setter Property="Background" Value="#2B2B2B" />
                                                <Setter Property="BorderBrush" Value="#2B2B2B" />
                                                <Setter Property="Foreground" Value="#F2F2F0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:T Report_MetricTotal}" Padding="10,4" Margin="0,0,30,0"
                                    Command="{Binding SetMetricCommand}" CommandParameter="total">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTotalMetric}" Value="True">
                                                <Setter Property="Background" Value="#2B2B2B" />
                                                <Setter Property="BorderBrush" Value="#2B2B2B" />
                                                <Setter Property="Foreground" Value="#F2F2F0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="{loc:T Report_Week}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="week">
<Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWeekPeriod}" Value="True">
                                                <Setter Property="Background" Value="#2B2B2B" />
                                                <Setter Property="BorderBrush" Value="#2B2B2B" />
                                                <Setter Property="Foreground" Value="#F2F2F0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>                            </Button>
                            <Button Content="{loc:T Report_Month}" Padding="10,4" Margin="0,0,6,0"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="month">
<Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonthPeriod}" Value="True">
                                                <Setter Property="Background" Value="#2B2B2B" />
                                                <Setter Property="BorderBrush" Value="#2B2B2B" />
                                                <Setter Property="Foreground" Value="#F2F2F0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>                            </Button>
                            <Button Content="{loc:T Report_Year}" Padding="10,4"
                                    Command="{Binding SetPeriodCommand}" CommandParameter="year">
<Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsYearPeriod}" Value="True">
                                                <Setter Property="Background" Value="#2B2B2B" />
                                                <Setter Property="BorderBrush" Value="#2B2B2B" />
                                                <Setter Property="Foreground" Value="#F2F2F0" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>                            </Button>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Stats}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Effective}" FontSize="12.5"
                                               VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <controls:ProportionBar Height="8" Track="Transparent" Slices="{Binding Bar}" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}"
                                                   FontSize="10.5" Margin="0,4,0,0" Opacity="0.75" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
