<UserControl x:Class="FocusLedger.App.Views.ReconcileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="对账" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" Margin="10,2,0,0" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="导入 CSV" Style="{StaticResource PrimaryButton}" Padding="12,6" Margin="0,0,6,0"
                        Command="{Binding ImportCsvCommand}" />
                <Button Content="清除导入" Style="{StaticResource GhostButton}" Padding="10,6" Margin="0,0,10,0"
                        Command="{Binding ClearClaimsCommand}" />
                <Button Content="前一天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding PreviousDayCommand}" />
                <Button Content="今天" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding TodayCommand}" />
                <Button Content="后一天" Style="{StaticResource GhostButton}" Padding="10,5"
                        Command="{Binding NextDayCommand}" />
            </StackPanel>
        </Grid>

        <!-- 主卡 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="你声称" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Claimed}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="证据支持" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Verified}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource StateActive}" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="差额" Style="{StaticResource Caption}" />
                        <TextBlock Text="{Binding Gap}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource StateOffTask}" />
                    </StackPanel>
                </Grid>

                <controls:ProportionBar Height="14" Margin="0,16,0,0" Track="#232329" Slices="{Binding SplitSlices}" />

                <TextBlock Text="{Binding Ratio}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                           Foreground="{StaticResource Accent}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- 差额归因 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="差额去哪了" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="这五项之和恒等于差额。其中「打折」不是假时间——是确实在学、但属于被动或静默，按权重折算的部分。"
                               Style="{StaticResource Caption}" Margin="0,4,0,12" TextWrapping="Wrap" />
                </StackPanel>

                <controls:ProportionBar Grid.Row="1" Height="12" Track="#232329" Slices="{Binding GapSlices}" />

                <ItemsControl Grid.Row="2" ItemsSource="{Binding GapRows}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="60" />
                                </Grid.ColumnDefinitions>

                                <Rectangle Grid.Column="0" Width="9" Height="9" RadiusX="2" RadiusY="2"
                                           Fill="{Binding Brush}" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="12.5" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Value}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Share}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasData}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <TextBlock Text="这一天还没有导入计时器记录。" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                    <TextBlock Text="点右上角「导入 CSV」，选番茄 Todo / Forest / Toggl 导出的文件。"
                               Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
