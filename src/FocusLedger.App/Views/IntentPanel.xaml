<UserControl x:Class="FocusLedger.App.Views.IntentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Border Style="{StaticResource Card}">
        <Grid>
            <!-- 空闲 -->
            <Grid Visibility="{Binding ShowIdle, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Intent_Title}" Style="{StaticResource H2}" FontSize="13.5" />
                    <TextBlock Text="{Binding ResultText}" FontSize="12.5" Margin="0,5,0,0"
                               Foreground="{DynamicResource Accent}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                               Text="{loc:T Intent_NextHint}" />
                </StackPanel>

                <Button Grid.Column="1" Content="{loc:T Intent_Start}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Command="{Binding BeginEditCommand}" />
            </Grid>

            <!-- 编辑 -->
            <StackPanel Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:T Intent_WhatNext}" Style="{StaticResource H2}" FontSize="13.5" />

                <TextBox Width="360" Margin="0,10,0,0" HorizontalAlignment="Left"
                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{loc:T Intent_Duration}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ItemsControl ItemsSource="{Binding Durations}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,8,0"
                                        Command="{Binding DataContext.SetDurationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="{Binding StringFormat={}{0} min}" FontSize="12.5" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:T Intent_Begin}" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Command="{Binding StartCommand}" />
                    <Button Content="{loc:T Intent_Cancel}" Style="{StaticResource GhostButton}" Padding="14,6" Margin="8,0,0,0"
                            Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 进行中 -->
            <StackPanel Visibility="{Binding ShowActive, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T Intent_Running}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveLabel}" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Remaining}" FontSize="13" VerticalAlignment="Center" />
                        <Button Content="{loc:T Intent_End}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="12,0,0,0"
                                Command="{Binding FinishCommand}" />
                        <Button Content="{loc:T Intent_GiveUp}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                                Foreground="{DynamicResource TextDim}" Command="{Binding AbandonCommand}" />
                    </StackPanel>
                </Grid>

                <controls:ProportionBar Height="10" Margin="0,12,0,0" Track="{DynamicResource TrackBg}" Slices="{Binding ProgressSlices}" />

                <TextBlock Text="{Binding AdherenceText}" Style="{StaticResource Caption}" Margin="0,8,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
