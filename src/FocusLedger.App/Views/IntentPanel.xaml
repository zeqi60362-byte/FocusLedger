<UserControl x:Class="FocusLedger.App.Views.IntentPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <!-- 上下间距交给外层页面控制，自己不再多贴一个 14，否则和下一张卡的 margin 叠成 28 -->
    <Border Style="{StaticResource Card}" Padding="18,16" Margin="0">
        <Grid>
            <!-- 空闲 -->
            <Grid Visibility="{Binding ShowIdle, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Intent_Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Text}" />
                    <TextBlock Text="{Binding ResultText}" FontSize="14" FontWeight="SemiBold" Margin="0,5,0,0"
                               Foreground="{DynamicResource Accent}" TextWrapping="Wrap"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,5,0,0" FontSize="11"
                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                               Text="{loc:T Intent_NextHint}" />
                </StackPanel>

                <Button Grid.Column="1" Content="{loc:T Intent_Start}"
                        Style="{StaticResource GhostButton}" Padding="16,7" VerticalAlignment="Center"
                        Background="{DynamicResource Surface}"
                        Foreground="{DynamicResource Text}"
                        BorderBrush="{DynamicResource Border}"
                        FontWeight="SemiBold"
                        Command="{Binding BeginEditCommand}" />
            </Grid>

            <!-- 编辑 -->
            <StackPanel Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{loc:T Intent_WhatNext}" FontSize="14" FontWeight="SemiBold" />

                <TextBox Width="360" Margin="0,10,0,0" HorizontalAlignment="Left"
                         Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="{loc:T Intent_Duration}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,10,0" />

                    <!-- 选中态靠 ListBox 的 IsSelected，点击后变深色 -->
                    <ListBox ItemsSource="{Binding Durations}"
                             SelectedItem="{Binding PlannedMinutes, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,8,0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Foreground" Value="{DynamicResource Text}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="16" Padding="14,5"
                                                    Background="{DynamicResource SurfaceAlt}"
                                                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#2B2B2B" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#2B2B2B" />
                                                    <Setter Property="Foreground" Value="#F2F2F0" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextDim}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat={}{0} min}" FontSize="12.5"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Text="{loc:T Intent_Custom}" Style="{StaticResource Caption}"
                               VerticalAlignment="Center" Margin="4,0,8,0" />
                    <TextBox Width="58" Padding="8,4" VerticalContentAlignment="Center"
                             Text="{Binding PlannedMinutes, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="min" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="背景音" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox Width="96" ItemsSource="{Binding MusicOptions}"
                              SelectedItem="{Binding SelectedMusicOption, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="{loc:T Intent_Begin}" Style="{StaticResource PrimaryButton}" Padding="16,6"
                            Command="{Binding StartCommand}" />
                    <Button Content="{loc:T Intent_Cancel}" Style="{StaticResource GhostButton}" Padding="14,6" Margin="8,0,0,0"
                            Command="{Binding CancelEditCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- 进行中：去掉卡片边框，让进度条成为视觉主体 -->
            <StackPanel Visibility="{Binding ShowActive, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="9" Height="9" Fill="{DynamicResource Accent}" Margin="0,1,10,0" />
                        <TextBlock Text="{Binding ActiveLabel}" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{loc:T Intent_Running}" Style="{StaticResource Caption}"
                                   Margin="10,3,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ActiveTrack}" Style="{StaticResource Caption}" FontSize="11"
                                   Margin="10,3,0,0" VerticalAlignment="Center" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Remaining}" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Content="{loc:T Intent_End}" Style="{StaticResource GhostButton}" Padding="10,4"
                                Command="{Binding FinishCommand}" />
                        <Button Content="{loc:T Intent_GiveUp}" Style="{StaticResource GhostButton}" Padding="10,4" Margin="6,0,0,0"
                                Foreground="{DynamicResource TextDim}" Command="{Binding AbandonCommand}" />
                    </StackPanel>
                </Grid>

                <controls:ProportionBar Height="9" Margin="0,14,0,0"
                                        Track="{DynamicResource TrackBg}" Slices="{Binding TimeSlices}" />
                <TextBlock Text="{Binding TimeProgressText}" Style="{StaticResource Caption}" FontSize="12.5" Margin="0,8,0,0" />

                <controls:ProportionBar Height="9" Margin="0,12,0,0"
                                        Track="{DynamicResource TrackBg}" Slices="{Binding ProgressSlices}" />

                <TextBlock Text="{Binding AdherenceText}" Style="{StaticResource Caption}" Margin="0,8,0,0" FontSize="12.5" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
