<UserControl x:Class="FocusLedger.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T Rules_Title}" Style="{StaticResource H2}" />
            <TextBlock Text="{loc:T Rules_Desc}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Rules_LastWindow}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding CurrentApp}" FontSize="12.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button Grid.Column="1" Content="{loc:T Rules_New}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Command="{Binding NewRuleFromCurrentCommand}" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource Caption}"
                   Foreground="{DynamicResource Accent}" Margin="2,10,0,0" TextWrapping="Wrap" />

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Grid.Row="0" Margin="4,0,4,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T Rules_Match}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="1" Text="{loc:T Rules_Source}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="2" Text="{loc:T Rules_Category}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="3" Text="{loc:T Rules_Priority}" Style="{StaticResource Caption}" />
                    <TextBlock Grid.Column="4" Text="{loc:T Rules_Enabled}" Style="{StaticResource Caption}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,0,4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding MatchText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding LabelText}" Style="{StaticResource Caption}" FontSize="10" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="2"
                                            Content="{Binding CategoryText}"
                                            Background="{Binding CategoryBackground}"
                                            Foreground="{Binding CategoryBrush}"
                                            BorderThickness="0"
                                            Padding="10,4"
                                            FontSize="11.5"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            ToolTip="{loc:T Rules_CycleHint}"
                                            Command="{Binding DataContext.CycleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <TextBlock Grid.Column="3" Text="{Binding PriorityText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />

                                    <CheckBox Grid.Column="4" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <Button Grid.Column="5" Content="{loc:T Rules_Delete}" Padding="6,3" FontSize="11"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
