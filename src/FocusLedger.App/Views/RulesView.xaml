<UserControl x:Class="FocusLedger.App.Views.RulesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <UserControl.Resources>
        <!-- 表头和「刚才在用的窗口」这类小标题：比 Caption 再重一档，方便扫读 -->
        <Style x:Key="RulesHead" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="{loc:T Rules_Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="{loc:T Rules_Desc}" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:T Rules_LastWindow}" Style="{StaticResource RulesHead}" FontSize="13" />
                    <StackPanel Orientation="Horizontal">
                        <ComboBox Width="430" HorizontalAlignment="Left" ItemsSource="{Binding Recents}" SelectedItem="{Binding SelectedRecent, Mode=TwoWay}" />
                        <!-- 下拉框里的选项不会自己更新：换窗口后点一下这里重新读 -->
                        <Button Content="{loc:T Rules_Refresh}" Style="{StaticResource GhostButton}"
                                Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip="{loc:T Rules_RefreshHint}"
                                Command="{Binding RefreshWindowListCommand}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="{loc:T Rules_New}"
                        Style="{StaticResource PrimaryButton}" VerticalAlignment="Center"
                        Command="{Binding NewRuleFromCurrentCommand}" />
            </Grid>
        </Border>

        <!-- 状态提示平时是空串：不收起来的话它会一直占着 10px 外边距 + 一行高度，
             把上下两张卡撑开一条莫名的空白。 -->
        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                    <Setter Property="Margin" Value="2,10,0,0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 表头 -->
                <Grid Grid.Row="0" Margin="10,0,10,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{loc:T Rules_Match}" Style="{StaticResource RulesHead}" />
                    <TextBlock Grid.Column="1" Text="{loc:T Rules_Source}" Style="{StaticResource RulesHead}" />
                    <TextBlock Grid.Column="2" Text="{loc:T Rules_Category}" Style="{StaticResource RulesHead}" />
                    <TextBlock Grid.Column="3" Text="{loc:T Rules_Priority}" Style="{StaticResource RulesHead}" />
                    <TextBlock Grid.Column="4" Text="{loc:T Rules_Enabled}" Style="{StaticResource RulesHead}" />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Padding="0,8" Margin="0,0,0,2"
                                        PreviewMouseLeftButtonUp="OnRuleRowClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid Margin="10,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="300" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- 刚建的规则挂一个绿点；点一下这条规则它就消失 -->
                                        <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center"
                                                 Fill="{DynamicResource StateActive}"
                                                 ToolTip="{loc:T Rules_NewBadge}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsNew}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding MatchText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding LabelText}" Style="{StaticResource Caption}" FontSize="10" />
                                        </StackPanel>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding SourceText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />

                                    <Button Grid.Column="2"
                                            Content="{Binding CategoryText}"
                                            Background="{Binding CategoryBackground}"
                                            Foreground="{Binding CategoryBrush}"
                                            BorderThickness="0"
                                            Padding="10,4"
                                            FontSize="11.5"
                                            Cursor="Hand"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Left"
                                            ToolTip="{loc:T Rules_CycleHint}"
                                            Command="{Binding DataContext.CycleCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>

                                    <TextBlock Grid.Column="3" Text="{Binding PriorityText}" Style="{StaticResource Caption}"
                                               VerticalAlignment="Center" />

                                    <CheckBox Grid.Column="4" IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />

                                    <Button Grid.Column="5" Content="{loc:T Rules_Delete}" Padding="6,3" FontSize="11"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
