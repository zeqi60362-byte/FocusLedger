<UserControl x:Class="FocusLedger.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Plan_Title}" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding HolidaySourceText}" Style="{StaticResource Caption}"
                           Margin="12,2,0,0" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Plan_Prev}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding PreviousMonthCommand}" />
                <Button Content="{loc:T Plan_Today}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding GoTodayCommand}" />
                <Button Content="{loc:T Plan_Next}" Style="{StaticResource GhostButton}" Padding="10,5"
                        Command="{Binding NextMonthCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 月历 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="46" Margin="2" Padding="0" Cursor="Hand"
                                        Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="14" Background="Transparent"
                                                    BorderThickness="1.5" BorderBrush="Transparent">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="Num" Text="{Binding Day}" FontSize="12.5"
                                                               HorizontalAlignment="Center" />
                                                    <Ellipse Width="5" Height="5" Margin="0,3,0,2"
                                                             HorizontalAlignment="Center"
                                                             Fill="{DynamicResource StateOffTask}"
                                                             Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                    <Setter TargetName="Num" Property="Opacity" Value="0.28" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource StateOffTask}" />
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HolidayBg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Bg}" />
                                                    <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                        <TextBlock Text="{Binding HolidayText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource StateOffTask}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 当天时间表 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDateText}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PlanCountText}" Style="{StaticResource Caption}"
                                       Margin="12,3,0,0" />
                        </StackPanel>
                        <TextBlock Text="{loc:T Plan_WriteHere}" Style="{StaticResource Caption}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Hours}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}"
                                                   Style="{StaticResource Caption}" VerticalAlignment="Center" />

                                        <!-- 可编辑：开始 – 结束 + 标题 -->
                                        <Grid Grid.Column="1" Visibility="{Binding IsEditable, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Horizontal"
                                                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                                                <ComboBox Width="62" Margin="0,0,4,0" FontSize="11" Padding="2,2"
                                                          ItemsSource="{Binding TimeOptions}"
                                                          SelectedItem="{Binding StartText, Mode=TwoWay}" />
                                                <TextBlock Text="–" Style="{StaticResource Caption}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                                <ComboBox Width="62" Margin="0,0,8,0" FontSize="11" Padding="2,2"
                                                          ItemsSource="{Binding TimeOptions}"
                                                          SelectedItem="{Binding EndText, Mode=TwoWay}" />
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Padding="8,4" FontSize="12"
                                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                        </Grid>

                                        <!-- 被上一条计划覆盖的小时：只读延续 -->
                                        <Border Grid.Column="1" CornerRadius="6" Padding="10,4" Margin="0,0,8,0"
                                                Background="{DynamicResource SurfaceAlt}"
                                                Visibility="{Binding IsContinuation, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↳" Style="{StaticResource Caption}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Text}" FontSize="12" Foreground="{DynamicResource TextDim}"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
