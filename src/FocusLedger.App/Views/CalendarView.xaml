<UserControl x:Class="FocusLedger.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 预设标签：选中时整枚变成主色，再点一次取消 -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="11,4" Margin="0,0,6,6"
                                Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextDim}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Bg}" />
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 两张卡之间的拖拽把手：只负责竖向拖，实际高度由 code-behind 改 WeekCard.Height -->
        <Style x:Key="SplitHandle" TargetType="Thumb">
            <Setter Property="Height" Value="12" />
            <Setter Property="Cursor" Value="SizeNS" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" Height="12">
                            <Border Width="44" Height="4" CornerRadius="2"
                                    VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Background="{DynamicResource Border}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SavePlanCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏（不跟着滚，始终在顶部） -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Plan_Title}" Style="{StaticResource PageTitle}" />
                <!-- 周期任务建完后的回执，空串时不占位 -->
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" Margin="12,3,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusText}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Plan_Prev}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding PreviousMonthCommand}" />
                <Button Content="{loc:T Plan_Today}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding GoTodayCommand}" />
                <Button Content="{loc:T Plan_Next}" Style="{StaticResource GhostButton}" Padding="10,5"
                        Command="{Binding NextMonthCommand}" />
            </StackPanel>
        </Grid>

        <!--
            计划页整体可滚动。
            这里刻意不用「星号行 + GridSplitter 分剩余空间」：一旦外层套 ScrollViewer，
            内容拿到的是无限高度，* 行就没有意义，分隔条也失去可拖的基准。
            改成：上面那张卡固定高度（分隔条就改这个数字），月历按内容自适应，两者一起滚。

            另外 HorizontalScrollBarVisibility 必须是 Disabled —— 横向一开，
            ScrollViewer 会用无限宽去量 WeekCanvas，最右一列又会被切掉。
        -->
        <ScrollViewer x:Name="PageScroll" Grid.Row="1" Margin="0,14,0,0"
                      VerticalScrollBarVisibility="Hidden"
                      HorizontalScrollBarVisibility="Disabled">

            <StackPanel>
                <!-- 本周时间画布 -->
                <Border x:Name="WeekCard" Style="{StaticResource Card}" Height="480" Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedDateText}" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding PlanCountText}" Style="{StaticResource Caption}"
                                           Margin="12,3,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{loc:T Plan_WriteHere}" Style="{StaticResource Caption}"
                                       Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </Grid>

                        <controls:WeekCanvas Grid.Row="1" Margin="0,2,0,0"
                                             Plans="{Binding WeekBlocks}"
                                             TodayIndex="{Binding TodayIndex}"
                                             RangeSelected="OnRangeSelected"
                                             BlockClicked="OnBlockClicked" />
                    </Grid>
                </Border>

                <Thumb Style="{StaticResource SplitHandle}" DragDelta="OnSplitterDrag" />

                <!-- 月历：高度跟着内容走 -->
                <Border Style="{StaticResource Card}" Padding="16">
                    <StackPanel>
                        <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="SemiBold" Margin="4,2,0,14" />

                        <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,0,0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Days}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Height="46" Margin="2" Padding="0" Cursor="Hand"
                                            Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="14" Background="Transparent"
                                                        BorderThickness="1.5" BorderBrush="Transparent">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="Num" Text="{Binding Day}" FontSize="12.5"
                                                                   HorizontalAlignment="Center" />
                                                        <Ellipse Width="5" Height="5" Margin="0,3,0,2"
                                                                 HorizontalAlignment="Center"
                                                                 Fill="{DynamicResource StateOffTask}"
                                                                 Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                        <Setter TargetName="Num" Property="Opacity" Value="0.28" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextDim}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource StateOffTask}" />
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HolidayBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                                        <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Bg}" />
                                                        <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                            <TextBlock Text="{Binding HolidayText}" Style="{StaticResource Caption}"
                                       Foreground="{DynamicResource StateOffTask}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 新建 / 编辑计划：整页遮罩 + 居中卡片（挂在滚动容器外层，滚动时不会跟着跑） -->
        <Grid x:Name="EditorOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#66000000"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="430" Padding="24" CornerRadius="20"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.24" Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding EditorHeading}" Style="{StaticResource H2}" FontSize="16" />
                    <TextBlock Text="{Binding EditorRange}" Style="{StaticResource Caption}" Margin="0,5,0,18" />

                    <TextBlock Text="{loc:T Plan_Presets}" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:T Plan_TitleLabel}" Style="{StaticResource Caption}" Margin="2,12,0,5" />
                    <TextBox x:Name="TitleBox" FontSize="14"
                             Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T Plan_LocationLabel}" Style="{StaticResource Caption}" Margin="2,0,0,5" />
                            <TextBox Text="{Binding EditorLocation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:T Plan_UrlLabel}" Style="{StaticResource Caption}" Margin="2,0,0,5" />
                            <TextBox Text="{Binding EditorUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <!-- 重复：只在新建时出现（编辑时改重复会在原日期上再铺一批） -->
                    <StackPanel Visibility="{Binding IsNewPlan, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{loc:T Plan_Repeat}" Style="{StaticResource Caption}" Margin="2,14,0,6" />

                        <ItemsControl ItemsSource="{Binding RepeatOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                            Command="{Binding DataContext.SetRepeatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding Mode}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 自定义星期：点任意一个就切到「自定义」 -->
                        <ItemsControl ItemsSource="{Binding RepeatDays}" Margin="0,2,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Style="{StaticResource ChipButton}" Content="{Binding Label}" MinWidth="34"
                                            Command="{Binding DataContext.ToggleRepeatDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 持续几周：选了重复才出现 -->
                        <StackPanel Visibility="{Binding HasRepeat, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{loc:T Plan_RepeatWeeks}" Style="{StaticResource Caption}" Margin="2,10,0,6" />
                            <ItemsControl ItemsSource="{Binding RepeatWeekOptions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                                Command="{Binding DataContext.SetRepeatWeeksCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <CheckBox Content="{loc:T Plan_RemindLabel}" IsChecked="{Binding EditorRemind}" Margin="2,16,0,0" />

                    <!-- 时间冲突 / 标题为空时在这里说明，弹窗不关，改完可以直接重存 -->
                    <TextBlock Text="{Binding EditorError}" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                <Setter Property="Foreground" Value="{DynamicResource StateOffTask}" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="Margin" Value="2,12,0,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding EditorError}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Margin="0,22,0,0">
                        <Button HorizontalAlignment="Left" Padding="14,6"
                                Style="{StaticResource GhostButton}"
                                Content="{loc:T Plan_Delete}"
                                Command="{Binding DeletePlanCommand}"
                                Visibility="{Binding IsExistingPlan, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Padding="16,6"
                                    Content="{loc:T Plan_Cancel}"
                                    Command="{Binding CancelEditorCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="18,6" Margin="8,0,0,0"
                                    Content="{loc:T Plan_Save}"
                                    Command="{Binding SavePlanCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
