<UserControl x:Class="FocusLedger.App.Views.CalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:FocusLedger.App.Localization"
             xmlns:controls="clr-namespace:FocusLedger.App.Controls">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- 预设标签：选中时整枚变成主色，再点一次取消 -->
        <Style x:Key="ChipButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="12" Padding="11,4" Margin="0,0,6,6"
                                Background="{DynamicResource SurfaceAlt}"
                                BorderBrush="{DynamicResource Border}" BorderThickness="1">
                            <TextBlock x:Name="Txt" Text="{TemplateBinding Content}" FontSize="12"
                                       FontFamily="{DynamicResource UiFont}"
                                       Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextDim}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource Bg}" />
                                <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelEditorCommand}" />
        <KeyBinding Key="Enter" Command="{Binding SavePlanCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏 -->
        <Grid Grid.Row="0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{loc:T Plan_Title}" Style="{StaticResource H2}" />
                <TextBlock Text="{Binding HolidaySourceText}" Style="{StaticResource Caption}"
                           Margin="12,2,0,0" VerticalAlignment="Bottom" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{loc:T Plan_Prev}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding PreviousMonthCommand}" />
                <Button Content="{loc:T Plan_Today}" Style="{StaticResource GhostButton}" Padding="10,5" Margin="0,0,6,0"
                        Command="{Binding GoTodayCommand}" />
                <Button Content="{loc:T Plan_Next}" Style="{StaticResource GhostButton}" Padding="10,5"
                        Command="{Binding NextMonthCommand}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="396" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 月历 -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="{Binding MonthTitle}" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,10" />

                    <ItemsControl ItemsSource="{Binding Weekdays}" Margin="0,0,0,4">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" Style="{StaticResource Caption}" HorizontalAlignment="Center" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Height="46" Margin="2" Padding="0" Cursor="Hand"
                                        Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="14" Background="Transparent"
                                                    BorderThickness="1.5" BorderBrush="Transparent">
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock x:Name="Num" Text="{Binding Day}" FontSize="12.5"
                                                               HorizontalAlignment="Center" />
                                                    <Ellipse Width="5" Height="5" Margin="0,3,0,2"
                                                             HorizontalAlignment="Center"
                                                             Fill="{DynamicResource StateOffTask}"
                                                             Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceAlt}" />
                                                </Trigger>
                                                <DataTrigger Binding="{Binding InMonth}" Value="False">
                                                    <Setter TargetName="Num" Property="Opacity" Value="0.28" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWeekend}" Value="True">
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextDim}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource StateOffTask}" />
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HolidayBg}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Accent}" />
                                                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource Bg}" />
                                                    <Setter TargetName="Num" Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="4,10,0,0">
                        <TextBlock Text="{Binding HolidayText}" Style="{StaticResource Caption}"
                                   Foreground="{DynamicResource StateOffTask}" TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 本周时间画布 -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                            <TextBlock Text="{Binding SelectedDateText}" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding PlanCountText}" Style="{StaticResource Caption}"
                                       Margin="12,3,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{loc:T Plan_WriteHere}" Style="{StaticResource Caption}"
                                   Margin="16,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>

                    <!-- 不要再套 ScrollViewer：它会拿无限宽去量画布，导致最右一列被切掉；
                         也不要把高度绑到 ViewportHeight，那会和滚动条互相反馈。画布自己铺满这一行。 -->
                    <controls:WeekCanvas Grid.Row="1" Margin="0,2,0,0"
                                         Plans="{Binding WeekBlocks}"
                                         TodayIndex="{Binding TodayIndex}"
                                         RangeSelected="OnRangeSelected"
                                         BlockClicked="OnBlockClicked" />
                </Grid>
            </Border>
        </Grid>

        <!-- 新建 / 编辑计划：整页遮罩 + 居中卡片 -->
        <Grid x:Name="EditorOverlay" Grid.Row="0" Grid.RowSpan="2" Background="#66000000"
              Visibility="{Binding IsEditorOpen, Converter={StaticResource BoolToVis}}">
            <Border Width="430" Padding="24" CornerRadius="20"
                    Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.24" Color="Black" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock Text="{Binding EditorHeading}" Style="{StaticResource H2}" FontSize="16" />
                    <TextBlock Text="{Binding EditorRange}" Style="{StaticResource Caption}" Margin="0,5,0,18" />

                    <TextBlock Text="{loc:T Plan_Presets}" Style="{StaticResource Caption}" Margin="2,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChipButton}" Content="{Binding Label}"
                                        Command="{Binding DataContext.ApplyPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{loc:T Plan_TitleLabel}" Style="{StaticResource Caption}" Margin="2,12,0,5" />
                    <TextBox x:Name="TitleBox" FontSize="14"
                             Text="{Binding EditorTitle, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{loc:T Plan_LocationLabel}" Style="{StaticResource Caption}" Margin="2,0,0,5" />
                            <TextBox Text="{Binding EditorLocation, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="{loc:T Plan_UrlLabel}" Style="{StaticResource Caption}" Margin="2,0,0,5" />
                            <TextBox Text="{Binding EditorUrl, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="{loc:T Plan_RemindLabel}" IsChecked="{Binding EditorRemind}" Margin="2,16,0,0" />

                    <Grid Margin="0,22,0,0">
                        <Button HorizontalAlignment="Left" Padding="14,6"
                                Style="{StaticResource GhostButton}"
                                Content="{loc:T Plan_Delete}"
                                Command="{Binding DeletePlanCommand}"
                                Visibility="{Binding IsExistingPlan, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource GhostButton}" Padding="16,6"
                                    Content="{loc:T Plan_Cancel}"
                                    Command="{Binding CancelEditorCommand}" />
                            <Button Style="{StaticResource PrimaryButton}" Padding="18,6" Margin="8,0,0,0"
                                    Content="{loc:T Plan_Save}"
                                    Command="{Binding SavePlanCommand}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
