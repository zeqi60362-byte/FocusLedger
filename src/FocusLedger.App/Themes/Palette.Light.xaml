<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 混凝土浅灰：暖灰底 + 纯白卡片 + 墨黑强调，图纸般的干净 -->
    <FontFamily x:Key="UiFont">Noto Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>

    <SolidColorBrush x:Key="Bg" Color="#EFEFED" />
    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F4F4F2" />
    <SolidColorBrush x:Key="Border" Color="#DCDCD8" />
    <SolidColorBrush x:Key="Text" Color="#111111" />
    <SolidColorBrush x:Key="TextDim" Color="#737373" />
    <SolidColorBrush x:Key="Accent" Color="#111111" />
<SolidColorBrush x:Key="AccentSoft" Color="#EDF5F1" />
    <SolidColorBrush x:Key="Danger" Color="#B3261E" />

    <SolidColorBrush x:Key="StateActive" Color="#2C7A52" />
    <SolidColorBrush x:Key="StateSilent" Color="#3B6EA5" />
    <SolidColorBrush x:Key="StateOffTask" Color="#B8483B" />
    <SolidColorBrush x:Key="StateIdle" Color="#A6A6A0" />
    <SolidColorBrush x:Key="StatePassive" Color="#8C8C8C" />
    <SolidColorBrush x:Key="StateLocked" Color="#E4E4E0" />
    <SolidColorBrush x:Key="StateAmbiguous" Color="#5E5E5E" />

    <SolidColorBrush x:Key="TrackBg" Color="#E4E4E1" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#C4C4C0" />
    <SolidColorBrush x:Key="TimelineBg" Color="#F7F7F5" />
    <SolidColorBrush x:Key="TimelineGrid" Color="#1F000000" />
    <SolidColorBrush x:Key="TimelineLabel" Color="#8A8A86" />
    <SolidColorBrush x:Key="HolidayBg" Color="#F6E4E1" />
    <SolidColorBrush x:Key="OverlayBg" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="OverlayText" Color="#222222" />

</ResourceDictionary>
