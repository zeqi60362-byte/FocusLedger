<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 石墨黑：中性无色相的深灰体系，仅保留一点克制的砖红作为警示色 -->
    <FontFamily x:Key="UiFont">Microsoft YaHei UI</FontFamily>

    <SolidColorBrush x:Key="Bg" Color="#0E0E0F" />
    <SolidColorBrush x:Key="Surface" Color="#161617" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#1F1F21" />
    <SolidColorBrush x:Key="Border" Color="#2B2B2E" />
    <SolidColorBrush x:Key="Text" Color="#F2F2F0" />
    <SolidColorBrush x:Key="TextDim" Color="#8E8E93" />
    <SolidColorBrush x:Key="Accent" Color="#F2F2F0" />
    <SolidColorBrush x:Key="Danger" Color="#D9695F" />

    <SolidColorBrush x:Key="StateActive" Color="#7FD8A6" />
    <SolidColorBrush x:Key="StateSilent" Color="#7FA6D9" />
    <SolidColorBrush x:Key="StateOffTask" Color="#D06A5E" />
    <SolidColorBrush x:Key="StateIdle" Color="#3E3E43" />
    <SolidColorBrush x:Key="StatePassive" Color="#9A9A9F" />
    <SolidColorBrush x:Key="StateLocked" Color="#242427" />
    <SolidColorBrush x:Key="StateAmbiguous" Color="#6B6B70" />

    <SolidColorBrush x:Key="TrackBg" Color="#26262A" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#3A3A3F" />
    <SolidColorBrush x:Key="TimelineBg" Color="#121213" />
    <SolidColorBrush x:Key="TimelineGrid" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TimelineLabel" Color="#78787E" />
    <SolidColorBrush x:Key="HolidayBg" Color="#2A1816" />
    <SolidColorBrush x:Key="OverlayBg" Color="#F01E1E20" />
    <SolidColorBrush x:Key="OverlayText" Color="#E6E6E4" />

</ResourceDictionary>
